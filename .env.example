# Required. Use a long random value for each one.
POSTGRES_PASSWORD=
# At least 32 characters. Changing it logs everyone out.
JWT_SECRET=

# Set to false after creating your account (recommended).
# REGISTRATION_ENABLED=true

# Optional: a mail server for reminder emails. Without one, reminders only show in the app.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=you@example.com
